<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Main Palette Colors -->
    <Color x:Key="WindowBackgroundColor">#F8FAFC</Color>
    <Color x:Key="PrimaryBrandColor">#4F46E5</Color>
    <Color x:Key="BrandHoverColor">#4338CA</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    
    <Color x:Key="SlateBorderColor">#E2E8F0</Color>
    <Color x:Key="SlateDarkColor">#0F172A</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="WorkspaceGridColor">#F1F5F9</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryBrandBrush" Color="{StaticResource PrimaryBrandColor}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    
    <SolidColorBrush x:Key="SlateBorderBrush" Color="{StaticResource SlateBorderColor}" />
    <SolidColorBrush x:Key="SlateDarkBrush" Color="{StaticResource SlateDarkColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="WorkspaceGridBrush" Color="{StaticResource WorkspaceGridColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
</ResourceDictionary>
