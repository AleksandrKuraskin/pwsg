<Window x:Class="DfaSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projektowanie i Symulacja Deterministycznych Automatów Skończonych (DFA)" 
        Height="720" Width="1200"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header bar -->
            <RowDefinition Height="64" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 🧭 TOP MENU / HEADER ACTIONS -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Brand Name -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Edytor i Symulator DFA" FontSize="16" FontFamily="Segoe UI" FontWeight="Bold" Foreground="{StaticResource SlateDarkBrush}" />
                    <TextBlock Text="Skończone Automaty Deterministyczne • Przybornik Akademicki" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium" />
                </StackPanel>

                <!-- Trigger Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Standard presets -->
                    <TextBlock Text="Przykłady:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <Button Content="Parzyste 0" Style="{StaticResource FlatButton}" Margin="0,0,6,0" Click="LoadEvenZerosPreset_Click" />
                    <Button Content="Kończy na 01" Style="{StaticResource FlatButton}" Margin="0,0,12,0" Click="LoadEndsWith01Preset_Click" />
                    
                    <Separator Width="1" Margin="4,8" Background="{StaticResource SlateBorderBrush}" />

                    <!-- File Operations -->
                    <Button Content="Importuj JSON" Style="{StaticResource FlatButton}" Background="{StaticResource SuccessBrush}" Click="ImportJson_Click" Margin="12,0,6,0" />
                    <Button Content="Eksportuj JSON" Style="{StaticResource FlatButton}" Background="{StaticResource SlateDarkBrush}" Click="ExportJson_Click" Margin="0,0,6,0" />
                    <Button Content="Zapisz Obrazek" Style="{StaticResource FlatButton}" Background="{StaticResource TextMutedBrush}" Click="SavePng_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 🚀 WORKSPACE & PANELS SPLIT -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" /> <!-- SVG-like interactive graphical Canvas area -->
                <ColumnDefinition Width="5*" /> <!-- Side Panel properties + simulation triggers -->
            </Grid.ColumnDefinitions>

            <!-- LEFT WORKSPACE: GRAPH EDITOR CANVAS -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top descriptor line -->
                <Border Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="OBSZAR RYSOWANIA (2x KLIK = DODAJ STAN, CHWYĆ = PRZESUŃ, KLIK = EDYCJA)" 
                               FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                </Border>

                <!-- The Interactive Drawing Canvas itself with elegant slate background and mouse captures -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <Canvas x:Name="DfaDrawCanvas" Background="Transparent" ClipToBounds="True"
                            MouseLeftButtonDown="DfaDrawCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="DfaDrawCanvas_MouseLeftButtonUp"
                            MouseMove="DfaDrawCanvas_MouseMove" />
                </Border>
            </Grid>

            <!-- RIGHT WORKSPACE: EDITOR & SIMULATION BENTO BLOCKS -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Tabs navigation bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Tab context panel -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tab toggle Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="TabLabBtn" Content="Lab: Projektowanie" Grid.Column="0" Height="36" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}" Checked="TabBtn_Checked" Click="TabBtn_Click" />
                    <RadioButton x:Name="TabHomeBtn" Content="Home: Symulacja" Grid.Column="1" Height="36" Style="{StaticResource {x:Type ToggleButton}}" Checked="TabBtn_Checked" Click="TabBtn_Click" />
                </Grid>

                <!-- Consolidated panels scroll contents -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
                    <StackPanel>
                        
                        <!-- TAB 1: LAB (EDITOR CONTROLS) UNLOCKS WHEN TABLAB IS CHECKED -->
                        <StackPanel x:Name="LabPanel" Visibility="Visible">
                            <!-- State Properties Card -->
                            <Border Style="{StaticResource GroupingCard}">
                                <StackPanel>
                                    <TextBlock Text="Ustawienia Stanu" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SlateDarkBrush}" Margin="0,0,0,12" />
                                    
                                    <StackPanel x:Name="StateEditorForm" Visibility="Collapsed">
                                        <!-- Label edit -->
                                        <TextBlock Text="Etykieta stanu" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox x:Name="StateLabelTextBox" Style="{StaticResource SlateTextBox}" Margin="0,0,0,10" TextChanged="StateLabelTextBox_TextChanged" />

                                        <!-- Initial / Accepting toggles -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="StateIsInitialChk" Content="Stan Początkowy" Grid.Column="0" Checked="StateCheckChanged" Unchecked="StateCheckChanged" />
                                            <CheckBox x:Name="StateIsAcceptingChk" Content="Oznacz akceptujący" Grid.Column="1" Checked="StateCheckChanged" Unchecked="StateCheckChanged" />
                                        </Grid>

                                        <!-- Promień, border size -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock x:Name="RadiusLabel" Text="Promień (28px)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                <Slider x:Name="RadiusSlider" Minimum="18" Maximum="45" Value="28" Style="{StaticResource StylingSlider}" ValueChanged="StateSliderChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock x:Name="BorderWidthLabel" Text="Grubość (2px)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                <Slider x:Name="BorderWidthSlider" Minimum="1" Maximum="6" Value="2" Style="{StaticResource StylingSlider}" ValueChanged="StateSliderChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Custom Colors pickers matching project specifications -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Kolor tła" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,2,0" />
                                                <ComboBox x:Name="FillColorComboBox" SelectedIndex="0" SelectionChanged="StateColorSelectionChanged">
                                                    <ComboBoxItem Content="#FFFFFF" Background="White" />
                                                    <ComboBoxItem Content="#F0FDF4" Background="#F0FDF4" />
                                                    <ComboBoxItem Content="#FEF2F2" Background="#FEF2F2" />
                                                    <ComboBoxItem Content="#EFF6FF" Background="#EFF6FF" />
                                                    <ComboBoxItem Content="#FEF3C7" Background="#FEF3C7" />
                                                    <ComboBoxItem Content="#E0F2FE" Background="#E0F2FE" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Kolor ramki" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,2,0" />
                                                <ComboBox x:Name="StrokeColorComboBox" SelectedIndex="0" SelectionChanged="StateColorSelectionChanged">
                                                    <ComboBoxItem Content="#475569" Background="#475569" Foreground="White" />
                                                    <ComboBoxItem Content="#16A34A" Background="#16A34A" Foreground="White" />
                                                    <ComboBoxItem Content="#EF4444" Background="#EF4444" Foreground="White" />
                                                    <ComboBoxItem Content="#2563EB" Background="#2563EB" Foreground="White" />
                                                    <ComboBoxItem Content="#D97706" Background="#D97706" Foreground="White" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Delete State Button -->
                                        <Button x:Name="DeleteStateBtn" Content="Usuń aktywny stan" Style="{StaticResource DangerButton}" Click="DeleteState_Click" />
                                    </StackPanel>

                                    <TextBlock x:Name="NoStateWarningBlock" Text="Wybierz stan dwuklikiem lub pojedynczym kliknięciem na płótnie, aby edytować." 
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10" />
                                </StackPanel>
                            </Border>

                            <!-- Add Transitions Card -->
                            <Border Style="{StaticResource GroupingCard}">
                                <StackPanel>
                                    <TextBlock Text="Zarządzanie Przejściami" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SlateDarkBrush}" Margin="0,0,0,12" />

                                    <!-- Delete Active transition box -->
                                    <Border x:Name="ActiveTransitionBox" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Aktywne Przejście" FontWeight="Bold" FontSize="11" Foreground="#92400E" />
                                                <TextBlock x:Name="ActiveTransitionDescBlock" Text="Z s0 do s1 na: 0" FontSize="10" Foreground="#B45309" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Usuń" Padding="8,4" Height="Auto" Style="{StaticResource DangerButton}" Click="DeleteTransition_Click" />
                                        </Grid>
                                    </Border>

                                    <!-- Create transition form -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Stan początkowy" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <ComboBox x:Name="TransFromComboBox" Height="30" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Stan końcowy" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <ComboBox x:Name="TransToComboBox" Height="30" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Etykiety (rozdzielone przecinkami, np: 0,1)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="TransSymbolsTextBox" Style="{StaticResource SlateTextBox}" Margin="0,0,0,12" Text="a" />

                                    <Button Content="Ustanów przejście" Style="{StaticResource FlatButton}" Height="34" Click="AddTransition_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Consolidated Alphabet block visualizer -->
                            <Border Style="{StaticResource GroupingCard}">
                                <StackPanel>
                                    <TextBlock Text="Aktualny Alfabet Wejściowy (Σ)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="AlphabetBlock" Text="{Binding AlphabetString, FallbackValue='Brak symboli wejściowych (dodaj przejścia)'}" 
                                               FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>


                        <!-- TAB 2: HOME (SIMULATOR RUNNER PANEL) UNLOCKS WHEN TABHOME IS CHECKED -->
                        <StackPanel x:Name="HomePanel" Visibility="Collapsed">
                            <!-- Word Input block -->
                            <Border Style="{StaticResource GroupingCard}">
                                <StackPanel>
                                    <TextBlock Text="Słowo wejściowe projektu" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SlateDarkBrush}" Margin="0,0,0,12" />
                                    <TextBox x:Name="InputWordTextBox" Style="{StaticResource SlateTextBox}" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" TextChanged="InputWordTextBox_TextChanged" />
                                    <TextBlock x:Name="InputWordWarningBlock" Text="Wpisz słowo złożone wyłącznie z symboli alfabetu." Foreground="{StaticResource DangerBrush}" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed" />

                                    <!-- Word visual highlighted trace -->
                                    <TextBlock Text="Postęp odczytu słowa:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,4" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" Background="#F1F5F9" Padding="8" SnapsToDevicePixels="True">
                                        <StackPanel x:Name="WordPreviewPanel" Orientation="Horizontal" HorizontalAlignment="Center" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Simulation debugger commands playback console -->
                            <Border Style="{StaticResource GroupingCard}">
                                <StackPanel>
                                    <TextBlock Text="Szybka Odtwarzarka" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SlateDarkBrush}" Margin="0,0,0,12" />
                                    
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /> <!-- Prev -->
                                            <ColumnDefinition Width="*" /> <!-- Play/Pause slider -->
                                            <ColumnDefinition Width="Auto" /> <!-- Next -->
                                            <ColumnDefinition Width="Auto" /> <!-- Reset -->
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="◀ Wstecz" Style="{StaticResource FlatButton}" Width="75" Margin="0,0,6,0" Click="SimStepPrev_Click" />
                                        
                                        <!-- Play Anim button -->
                                        <Button x:Name="SimPlayBtn" Content="▶ Uruchom" Grid.Column="1" Style="{StaticResource FlatButton}" Background="{StaticResource PrimaryBrandBrush}" Click="SimPlay_Click" Margin="0,0,6,0" />
                                        
                                        <Button Grid.Column="2" Content="Następny ▶" Style="{StaticResource FlatButton}" Width="90" Margin="0,0,6,0" Click="SimStepNext_Click" />
                                        <Button Grid.Column="3" Content="⟳" Style="{StaticResource FlatButton}" Width="32" Background="{StaticResource TextMutedBrush}" Click="SimReset_Click" />
                                    </Grid>

                                    <!-- Speed slider setting -->
                                    <TextBlock x:Name="SpeedLabelBlock" Text="Szybkość animacji: 1000ms" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <Slider x:Name="SimSpeedSlider" Minimum="200" Maximum="2000" Value="1000" TickFrequency="100" IsSnapToTickEnabled="True" Style="{StaticResource StylingSlider}" ValueChanged="SimSpeedSlider_ValueChanged" />
                                </StackPanel>
                            </Border>

                            <!-- Real-time calculation Verdict dashboard -->
                            <Border x:Name="VerdictCard" Style="{StaticResource GroupingCard}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Wynik Obliczeń" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SlateDarkBrush}" Margin="0,0,0,6" />
                                    <Border x:Name="VerdictStatusBorder" CornerRadius="8" Padding="12" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="VerdictTitleBlock" Text="STAN AKCEPTACJI" FontSize="14" FontWeight="Bold" />
                                            <TextBlock x:Name="VerdictDescBlock" Text="Opis werdyktu..." FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Visual Step execution list -->
                            <Border Style="{StaticResource GroupingCard}">
                                <StackPanel>
                                    <TextBlock Text="Historia Kroków Przejścia" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SlateDarkBrush}" Margin="0,0,0,8" />
                                    <ListView x:Name="StepsListView" Height="150" Grid.IsSharedSizeScope="True" BorderThickness="0">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Krok" DisplayMemberBinding="{Binding Path=StepIndex}" Width="45" />
                                                <GridViewColumn Header="Stan" DisplayMemberBinding="{Binding Path=StateId}" Width="65" />
                                                <GridViewColumn Header="Symbol" DisplayMemberBinding="{Binding Path=Symbol}" Width="65" />
                                                <GridViewColumn Header="Pozostało" DisplayMemberBinding="{Binding Path=RemainingWord}" Width="120" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
